{
  "name": "AI - Format Thai (Haiku)",
  "nodes": [
    {
      "parameters": {},
      "id": "trigger-1",
      "name": "When Executed by Another Workflow",
      "type": "n8n-nodes-base.executeWorkflowTrigger",
      "typeVersion": 1,
      "position": [240, 300]
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            { "id": "a1", "name": "raw_text", "value": "={{ $json.raw_text }}", "type": "string" },
            { "id": "a2", "name": "tone", "value": "={{ $json.tone || 'polite' }}", "type": "string" },
            { "id": "a3", "name": "max_chars", "value": "={{ $json.max_chars || 280 }}", "type": "number" }
          ]
        }
      },
      "id": "set-1",
      "name": "Filter Payload",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [460, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.anthropic.com/v1/messages",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "anthropic-version", "value": "2023-06-01" },
            { "name": "content-type", "value": "application/json" }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"model\": \"claude-haiku-4-5-20251001\",\n  \"max_tokens\": 512,\n  \"system\": \"คุณเป็นผู้ช่วยขัดเกลาภาษาไทยสำหรับตอบกลับพนักงานผ่าน LINE. ปรับให้สุภาพ ชัดเจน กระชับ ไม่เกิน {{ $json.max_chars }} ตัวอักษร. โทน: {{ $json.tone }}. ห้ามเพิ่มข้อมูลที่ไม่มีในต้นฉบับ. ตอบเฉพาะข้อความที่ขัดเกลา ไม่มีคำอธิบาย.\",\n  \"messages\": [\n    { \"role\": \"user\", \"content\": {{ JSON.stringify($json.raw_text) }} }\n  ]\n}",
        "options": { "timeout": 15000 }
      },
      "id": "http-1",
      "name": "Anthropic Haiku - Format",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [680, 300],
      "credentials": {
        "httpHeaderAuth": { "id": "REPLACE_WITH_CRED_ID", "name": "Anthropic API Key" }
      }
    },
    {
      "parameters": {
        "jsCode": "const text = $input.first().json.content?.[0]?.text?.trim() || '';\nreturn [{ json: { formatted: text } }];"
      },
      "id": "code-1",
      "name": "Extract Text",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [900, 300]
    }
  ],
  "connections": {
    "When Executed by Another Workflow": { "main": [[{ "node": "Filter Payload", "type": "main", "index": 0 }]] },
    "Filter Payload": { "main": [[{ "node": "Anthropic Haiku - Format", "type": "main", "index": 0 }]] },
    "Anthropic Haiku - Format": { "main": [[{ "node": "Extract Text", "type": "main", "index": 0 }]] }
  },
  "settings": { "executionOrder": "v1" }
}
